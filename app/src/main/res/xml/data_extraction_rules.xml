<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. Where the user's devices were last seen never leaves the phone (#162, #19). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/last_seen.preferences_pb" />
        <exclude domain="file" path="datastore/last_seen_demo.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/last_seen.preferences_pb" />
        <exclude domain="file" path="datastore/last_seen_demo.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
